    <item id="img-smart-grid" href="images/diagrams/smart-grid.svg" media-type="image/svg+xml"/>
    

  </manifest>
  
  <!-- ========================================
       SPINE - Reading order
       ======================================== -->
  <spine>
    <!-- Cover -->
    <itemref idref="cover-xhtml" linear="no"/>
    
    <!-- Front matter -->
    <itemref idref="intro"/>
    
    <!-- Sub-Book 1: Solar Energy -->
    <itemref idref="sb1-intro"/>
    <itemref idref="sb1-ch1"/>
    <itemref idref="sb1-ch2"/>
    <itemref idref="sb1-ch3"/>
    <itemref idref="sb1-ch4"/>
    
    <!-- Sub-Book 2: Wind Energy -->
    <itemref idref="sb2-intro"/>
    <itemref idref="sb2-ch1"/>
    <itemref idref="sb2-ch2"/>
    <itemref idref="sb2-ch3"/>
    
    <!-- Sub-Book 3: Energy Storage & Grid Integration -->
    <itemref idref="sb3-intro"/>
    <itemref idref="sb3-ch1"/>
    <itemref idref="sb3-ch2"/>
    <itemref idref="sb3-ch3"/>
    <itemref idref="sb3-ch4"/>
    
    <!-- Back matter -->
    <itemref idref="conclusion"/>
    <itemref idref="appendix"/>
  </spine>
  
