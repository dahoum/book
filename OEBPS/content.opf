<?xml version="1.0" encoding="UTF-8"?>
<package version="3.0" xmlns="http://www.idpf.org/2007/opf" 
         unique-identifier="bookid" prefix="ibooks: http://vocabulary.itunes.apple.com/rdf/ibooks/1.0/">
  
  <!-- ========================================
       METADATA
       ======================================== -->
  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/" 
            xmlns:dcterms="http://purl.org/dc/terms/" 
            xmlns:opf="http://www.idpf.org/2007/opf">
    
    <!-- Identifier -->
    <dc:identifier id="bookid">urn:uuid:RENEWABLE-ENERGY-TECH-BOOK-001</dc:identifier>
    
    <!-- Title -->
    <dc:title id="title">Renewable Energy: Technical Foundations and Applications</dc:title>
    <meta refines="#title" property="title-type">main</meta>
    
    <!-- Alternative titles -->
    <dc:title id="subtitle">Practical Guide for Professionals</dc:title>
    <meta refines="#subtitle" property="title-type">subtitle</meta>
    
    <!-- Creator/Author -->
    <dc:creator id="creator">IJ Verlag Technical Publications</dc:creator>
    <meta refines="#creator" property="role" scheme="marc:relators">aut</meta>
    
    <!-- Contributors -->
    <dc:contributor id="contrib-editor">Dr. Elena Solaris</dc:contributor>
    <meta refines="#contrib-editor" property="role" scheme="marc:relators">edt</meta>
    
    <dc:contributor id="contrib-illustrator">Max Windler</dc:contributor>
    <meta refines="#contrib-illustrator" property="role" scheme="marc:relators">ill</meta>
    
    <!-- Language -->
    <dc:language>en-US</dc:language>
    
    <!-- Date -->
    <dc:date>2026-09-17</dc:date>
    <meta property="dcterms:modified">2026-09-17T00:00:00Z</meta>
    
    <!-- Publisher -->
    <dc:publisher>IJ Verlag</dc:publisher>
    
    <!-- Description -->
    <dc:description>A technical deep-dive into renewable energy systems, covering fundamental principles, engineering implementations, economic analysis, and future technologies. Structured as a comprehensive reference with detailed charts, diagrams, and real-world case studies.</dc:description>
    
    <!-- Subjects/Keywords -->
    <dc:subject>Renewable Energy</dc:subject>
    <dc:subject>Solar Power</dc:subject>
    <dc:subject>Wind Energy</dc:subject>
    <dc:subject>Hydropower</dc:subject>
    <dc:subject>Energy Storage</dc:subject>
    <dc:subject>Sustainable Technology</dc:subject>
    <dc:subject>Engineering</dc:subject>
    
    <!-- Rights -->
    <dc:rights>Copyright (c) 2026 IJ Verlag. All rights reserved.</dc:rights>
    
    <!-- Format -->
    <meta property="dcterms:format">EPUB 3.0</meta>
    
    <!-- Cover -->
    <meta name="cover" content="cover-image"/>
    
    <!-- Reading progression -->
    <meta property="rendition:flow">auto</meta>
    <meta property="rendition:layout">reflowable</meta>
    <meta property="rendition:orientation">auto</meta>
    <meta property="rendition:spread">auto</meta>
    
    <!-- iBooks specific -->
    <meta property="ibooks:version">1.0</meta>
    <meta property="ibooks:specified-fonts">true</meta>
    
    <!-- Accessibility -->
    <meta property="schema:accessibilityFeature">tableOfContents</meta>
    <meta property="schema:accessibilityFeature">structuredNavigation</meta>
    <meta property="schema:accessibilityHazard">none</meta>
  </metadata>
  
