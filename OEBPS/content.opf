    <item id="sb2-ch2" href="content/subbook2/chapter2.xhtml" media-type="application/xhtml+xml"/>
    <item id="sb2-ch3" href="content/subbook2/chapter3.xhtml" media-type="application/xhtml+xml"/>
    
    <!-- Sub-Book 3: Energy Storage & Grid Integration -->
    <item id="sb3-intro" href="content/subbook3/subbook3.xhtml" media-type="application/xhtml+xml"/>
    <item id="sb3-ch1" href="content/subbook3/chapter1.xhtml" media-type="application/xhtml+xml"/>
    <item id="sb3-ch2" href="content/subbook3/chapter2.xhtml" media-type="application/xhtml+xml"/>
