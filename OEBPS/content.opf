    <!-- Conclusion -->
    <item id="conclusion" href="content/conclusion.xhtml" media-type="application/xhtml+xml"/>
    
    <!-- Appendix -->
    <item id="appendix" href="content/appendix.xhtml" media-type="application/xhtml+xml"/>
    
    <!-- Images: Charts -->
    <item id="img-solar-growth" href="images/charts/solar-growth.svg" media-type="image/svg+xml"/>
    <item id="img-solar-efficiency" href="images/charts/solar-efficiency.svg" media-type="image/svg+xml"/>
    <item id="img-wind-capacity" href="images/charts/wind-capacity.svg" media-type="image/svg+xml"/>
    <item id="img-wind-turbine-sizes" href="images/charts/wind-turbine-sizes.svg" media-type="image/svg+xml"/>
    <item id="img-storage-costs" href="images/charts/storage-costs.svg" media-type="image/svg+xml"/>
    <item id="img-grid-penetration" href="images/charts/grid-penetration.svg" media-type="image/svg+xml"/>
